<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp" android:gravity="center_vertical">
    <TextView android:id="@+id/s_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Próxima mejora" android:textColor="#9FB0C8" android:textSize="11sp" />
    <Chronometer android:id="@+id/s_chr" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#F2B632" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/s_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#F2B632" android:textSize="22sp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/s_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#EEF2F8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/s_acc" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#9FB0C8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/s_free" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#F6DFA6" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
